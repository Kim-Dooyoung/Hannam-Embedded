#include <Servo.h>

Servo myservo;

// 초음파 센서 및 LED 핀 설정
#define TRIG1 9 // 초음파 센서 1 Trig 핀 -> 모터 제어
#define ECHO1 8 // 초음파 센서 1 Echo 핀
#define TRIG2 7 // 초음파 센서 2 Trig 핀 -> LED 제어
#define ECHO2 6 // 초음파 센서 2 Echo 핀
#define LED_PIN 3 // LED 핀 설정

void setup() {
  Serial.begin(9600);

  // 핀 모드 설정
  pinMode(TRIG1, OUTPUT);
  pinMode(ECHO1, INPUT);
  pinMode(TRIG2, OUTPUT);
  pinMode(ECHO2, INPUT);
  pinMode(LED_PIN, OUTPUT);

  // 서보 모터 초기화
  myservo.attach(2);
  myservo.write(0); // 서보 모터 초기 위치
}

void loop() {
  long duration2;
  float distance2;

  // 초음파 센서 2 신호 보내기
  digitalWrite(TRIG2, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG2, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG2, LOW);

  // 초음파 센서 2 신호 수신
  duration2 = pulseIn(ECHO2, HIGH);
  distance2 = duration2 * 0.034 / 2;

  // 거리 출력
  Serial.print("Distance2: ");
  Serial.print(distance2);
  Serial.println(" cm (Sensor 2)");

  // 초음파 센서 2 조건: 거리 5cm 이하 -> LED 켜기
  if (distance2 <= 5.0) {
    Serial.println("Object detected by Sensor 2. Turning on LED...");
    digitalWrite(LED_PIN, HIGH); // LED 켜기
  } else {
    digitalWrite(LED_PIN, LOW);  // LED 끄기
  }

  delay(100); // 반복 간 딜레이
}
